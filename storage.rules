rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default Deny: Zero insecure defaults
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Strict Owner-Isolated Storage:
    // Only the authenticated user whose UID matches the folder path can read or write
    match /handwritten/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Guest / Transient Preview Buffer (Write-only for OCR processing, strictly size-capped)
    match /handwritten/guest/{fileName} {
      allow write: if request.resource.size < 10 * 1024 * 1024 
                   && request.resource.contentType.matches('image/.*');
      allow read: if false;
    }
  }
}
